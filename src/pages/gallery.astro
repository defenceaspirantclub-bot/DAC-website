---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Gallery | Defence Aspirant Club">
  <main>
    <section class="border-t border-line bg-surface px-5 py-18">
      <div class="mx-auto max-w-5xl reveal">
        <p class="eyebrow">---In pictures---</p>
        <h2>Gallery</h2>

        <p>
          Moments from our drills, lectures, visits and celebrations.
        </p>

        <div class="mt-7 grid grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-3">

          <figure class="flex aspect-4/3 items-end border border-line bg-[repeating-linear-gradient(135deg,var(--surface)_0_14px,var(--page)_14px_28px)]">
            <figcaption class="w-full bg-olive px-3 py-2 text-[.95rem] text-on-olive">
              Morning PT and drill
            </figcaption>
          </figure>

          <figure class="flex aspect-4/3 items-end border border-line bg-[repeating-linear-gradient(135deg,var(--surface)_0_14px,var(--page)_14px_28px)]">
            <figcaption class="w-full bg-olive px-3 py-2 text-[.95rem] text-on-olive">
              Guest lecture
            </figcaption>
          </figure>

          <figure class="flex aspect-4/3 items-end border border-line bg-[repeating-linear-gradient(135deg,var(--surface)_0_14px,var(--page)_14px_28px)]">
            <figcaption class="w-full bg-olive px-3 py-2 text-[.95rem] text-on-olive">
              Mock GTO tasks
            </figcaption>
          </figure>

          <figure class="flex aspect-4/3 items-end border border-line bg-[repeating-linear-gradient(135deg,var(--surface)_0_14px,var(--page)_14px_28px)]">
            <figcaption class="w-full bg-olive px-3 py-2 text-[.95rem] text-on-olive">
              NDA visit
            </figcaption>
          </figure>

          <figure class="flex aspect-4/3 items-end border border-line bg-[repeating-linear-gradient(135deg,var(--surface)_0_14px,var(--page)_14px_28px)]">
            <figcaption class="w-full bg-olive px-3 py-2 text-[.95rem] text-on-olive">
              Mock SSB interview
            </figcaption>
          </figure>

        </div>
      </div>
    </section>
  </main>
</Layout>
