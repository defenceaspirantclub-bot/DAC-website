---
import Layout from "../layouts/Layout.astro";
import { gallery } from "../data/site";
---

<Layout title="Gallery | Defence Aspirant Club">
  <main>
    <section class="border-t border-line bg-surface px-5 py-18">
      <div class="mx-auto max-w-5xl reveal">
        <p class="eyebrow">---In pictures---</p>
        <h2>Gallery</h2>

        <p>Moments from our drills, lectures, visits and celebrations.</p>

        <div
          class="mt-7 grid grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-3"
        >
          {
            gallery.map((g) => (
              <figure class="relative flex aspect-4/3 items-end overflow-hidden border border-line bg-[repeating-linear-gradient(135deg,var(--surface)_0_14px,var(--page)_14px_28px)]">
                {g.src && (
                  <img
                    src={g.src}
                    alt={g.alt}
                    loading="lazy"
                    class="absolute inset-0 h-full w-full object-cover"
                  />
                )}
                <figcaption class="relative w-full bg-olive px-3 py-2 text-[.95rem] text-on-olive">
                  {g.caption}
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
