---
import Layout from "../layouts/Layout.astro";
---

<Layout title="SSB | Defence Aspirant Club">
  <main>
    <section class="border-t border-line bg-surface px-5 py-18">
      <div class="mx-auto max-w-5xl reveal">
        <p class="eyebrow">04 · Preparation</p>
        <h2>SSB Interview Guidance</h2>
        <p>
          The Services Selection Board (SSB) is a five-day assessment of
          personality, not just knowledge. We prepare cadets for each stage
          through regular practice.
        </p>
        <ol class="ssb mt-7 grid gap-3.5">
          <li
            class="ssb-item grid gap-0.5 border border-line bg-page px-4.5 py-3.5 sm:grid-cols-[64px_1fr] sm:gap-4"
          >
            <div>
              <b class="font-semibold">Screening</b><span
                class="block text-base text-muted"
                >We run mock OIR (verbal and non-verbal reasoning) tests and
                picture perception and discussion (PP&amp;DT) practice.</span>
            </div>
          </li>
          <li
            class="ssb-item grid gap-0.5 border border-line bg-page px-4.5 py-3.5 sm:grid-cols-[64px_1fr] sm:gap-4"
          >
            <div>
              <b class="font-semibold">Psychology tests</b><span
                class="block text-base text-muted"
                >Weekly practice of TAT, WAT, SRT and Self Description to build
                quick, natural and positive thinking.</span>
            </div>
          </li>
          <li
            class="ssb-item grid gap-0.5 border border-line bg-page px-4.5 py-3.5 sm:grid-cols-[64px_1fr] sm:gap-4"
          >
            <div>
              <b class="font-semibold">Group Testing Officer tasks</b><span
                class="block text-base text-muted"
                >Group discussions, group planning exercise, progressive group
                tasks and command tasks in the field.</span>
            </div>
          </li>
          <li
            class="ssb-item grid gap-0.5 border border-line bg-page px-4.5 py-3.5 sm:grid-cols-[64px_1fr] sm:gap-4"
          >
            <div>
              <b class="font-semibold">Personal interview</b><span
                class="block text-base text-muted"
                >Mock interviews with serving and retired officers, with
                feedback on confidence and honesty.</span>
            </div>
          </li>
          <li
            class="ssb-item grid gap-0.5 border border-line bg-page px-4.5 py-3.5 sm:grid-cols-[64px_1fr] sm:gap-4"
          >
            <div>
              <b class="font-semibold">Conference</b><span
                class="block text-base text-muted"
                >Sessions on communication, current affairs, physical fitness
                and good daily habits.</span>
            </div>
          </li>
        </ol>
      </div>
    </section>
  </main>
</Layout>
