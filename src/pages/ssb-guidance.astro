---
import Layout from "../layouts/Layout.astro";
import { ssbSteps } from "../data/site";
---

<Layout title="SSB | Defence Aspirant Club">
  <main>
    <section class="border-t border-line bg-surface px-5 py-18">
      <div class="mx-auto max-w-5xl reveal">
        <p class="eyebrow">---Preparation---</p>
        <h2>SSB Interview Guidance</h2>
        <p>
          The Services Selection Board (SSB) is a five-day assessment of
          personality, not just knowledge. We prepare cadets for each stage
          through regular practice.
        </p>
        <ol class="ssb mt-7 grid gap-3.5">
          {
            ssbSteps.map((s) => (
              <li class="ssb-item grid gap-0.5 border border-line bg-page px-4.5 py-3.5 sm:grid-cols-[64px_1fr] sm:gap-4">
                <div>
                  <b class="font-semibold">{s.title}</b>
                  <span class="block text-base text-muted">{s.text}</span>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </main>
</Layout>
