---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Visits | Defence Aspirant Club">
  <main>
    <section class="border-t border-line bg-surface px-5 py-18">
      <div class="mx-auto max-w-5xl reveal">
        <p class="eyebrow">06 · In the field</p>
        <h2>Visits</h2>
        <p>
          Seeing the forces up close is the best motivation. DAC members visit
          defence institutions and events.
        </p>
        <div class="card-grid">
          <div class="card bg-page">
            <h3>NDA Passing Out Parade</h3>
            <p>
              Watch the cadets of the National Defence Academy march at the end
              of their training.
            </p>
          </div>
          <div class="card bg-page">
            <h3>Defence events</h3>
            <p>
              Air shows, military exhibitions, naval ship open days and army
              displays.
            </p>
          </div>
          <div class="card bg-page">
            <h3>Army, Navy and Air Force units</h3>
            <p>
              Interaction with personnel, and a look at equipment and daily
              routine.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
