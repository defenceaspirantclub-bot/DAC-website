---
import Layout from "../layouts/Layout.astro";
import { events } from "../data/site";
---

<Layout title="Events | Defence Aspirant Club">
  <main>
    <section class="border-t border-line px-5 py-18">
      <div class="mx-auto max-w-5xl reveal">
        <p class="eyebrow">---What's next---</p>
        <h2>Upcoming Events</h2>
        <p>
          Lectures and sessions by recommended candidates, serving officers and
          veterans.
        </p>
        <ul class="mt-7 grid gap-3">
          {
            events.map((e) => (
              <li class="grid gap-1 border border-line bg-surface px-4.5 py-3.5 sm:grid-cols-[110px_1fr] sm:gap-4.5">
                <time class="font-display text-[1.35rem] leading-[1.1] font-bold text-brass">
                  {e.date}
                  <br />
                  {e.year}
                </time>
                <div>
                  <h3>{e.title}</h3>
                  <p class="my-[.2em] text-base text-muted">{e.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</Layout>
