---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Events | Defence Aspirant Club">
  <main>
    <section class="border-t border-line px-5 py-18">
      <div class="mx-auto max-w-5xl reveal">
        <p class="eyebrow">05 · What's next</p>
        <h2>Upcoming Events</h2>
        <p>
          Lectures and sessions by recommended candidates, serving officers and
          veterans.
        </p>
        <ul class="mt-7 grid gap-3">
          <li
            class="grid gap-1 border border-line bg-surface px-4.5 py-3.5 sm:grid-cols-[110px_1fr] sm:gap-4.5"
          >
            <time
              class="font-display text-[1.35rem] leading-[1.1] font-bold text-brass"
              >DD Mon<br />2026</time
            >
            <div>
              <h3>Lecture by an NDA recommended candidate</h3>
              <p class="my-[.2em] text-base text-muted">
                How I prepared, my SSB experience and mistakes to avoid. Venue
                and time to be added.
              </p>
            </div>
          </li>
          <li
            class="grid gap-1 border border-line bg-surface px-4.5 py-3.5 sm:grid-cols-[110px_1fr] sm:gap-4.5"
          >
            <time
              class="font-display text-[1.35rem] leading-[1.1] font-bold text-brass"
              >DD Mon<br />2026</time
            >
            <div>
              <h3>Talk by a serving Army officer</h3>
              <p class="my-[.2em] text-base text-muted">
                Life in uniform and what the forces look for in an officer.
              </p>
            </div>
          </li>
          <li
            class="grid gap-1 border border-line bg-surface px-4.5 py-3.5 sm:grid-cols-[110px_1fr] sm:gap-4.5"
          >
            <time
              class="font-display text-[1.35rem] leading-[1.1] font-bold text-brass"
              >DD Mon<br />2026</time
            >
            <div>
              <h3>Mock SSB day</h3>
              <p class="my-[.2em] text-base text-muted">
                Group tasks, interviews and feedback, all in one day.
              </p>
            </div>
          </li>
        </ul>
      </div>
    </section>
  </main>
</Layout>
