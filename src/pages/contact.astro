---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact | Defence Aspirant Club">
  <main>
    <footer class="bg-olive px-5 pt-14 pb-[calc(2.75rem+env(safe-area-inset-bottom))] text-center text-on-olive">
      <p class="eyebrow text-3xl">Contact</p>

      <div class="mt-6 flex items-center justify-center gap-5">
        <a
          href="mailto:defenceaspirantclub@gmail.com?subject=Enquiry%20about%20DAC"
          aria-label="Email DAC"
          class="icon-btn"
        >
          <svg
            width="24"
            height="24"
            class="h-6 w-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
            ></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </a>

        <a
          href="https://www.instagram.com/aissms_defence_aspirant_club/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="DAC on Instagram"
          class="icon-btn"
        >
          <svg
            width="24"
            height="24"
            class="h-6 w-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
      </div>

      <p class="mx-auto mt-4 text-base opacity-90">
        defenceaspirantclub@gmail.com
      </p>

      <div class="mx-auto mt-10 max-w-5xl border-t border-on-olive/20 pt-6">
        <p class="mx-auto text-sm opacity-70">
          &copy; 2026 Defence Aspirant Club (DAC)
        </p>
      </div>
    </footer>
  </main>
</Layout>
