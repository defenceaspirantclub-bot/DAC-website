---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found | Defence Aspirant Club"
  description="The page you were looking for could not be found."
>
  <main>
    <section class="bg-olive px-5 pt-40 pb-24 text-center text-on-olive">
      <div class="mx-auto max-w-3xl">
        <p class="eyebrow">---Error 404---</p>
        <h1 class="text-[clamp(3rem,12vw,7rem)] font-extrabold uppercase">
          Off the map
        </h1>
        <p class="mx-auto text-xl opacity-90">
          We couldn't find the page you were looking for. It may have moved, or
          the link may be wrong.
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="/" class="btn btn-primary">Back to home</a>
          <a href="/about-dac/" class="btn btn-ghost">About DAC</a>
        </div>
      </div>
    </section>
  </main>
</Layout>