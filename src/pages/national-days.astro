---
import Layout from "../layouts/Layout.astro";
---

<Layout title="National Days | Defence Aspirant Club">
  <main>
    <section class="border-t border-line px-5 py-18">
      <div class="mx-auto max-w-5xl reveal">
        <p class="eyebrow">---Celebrations---</p>
        <h2>Republic Day and Independence Day</h2>
        <p>
          Every year DAC marks 26 January and 15 August with the respect they
          deserve. Our members take part and lead the programme.
        </p>
        <div class="card-grid">
          <div class="card">
            <h3>Flag hoisting</h3>
            <p>
              Ceremonial flag hoisting, national anthem and a guard of honour by
              DAC members.
            </p>
          </div>
          <div class="card">
            <h3>Drill and march past</h3>
            <p>
              Our members present a precise march past they have practised for
              weeks.
            </p>
          </div>
          <div class="card">
            <h3>Tributes and talks</h3>
            <p>
              Tributes to martyrs, patriotic speeches, songs and an address by a
              veteran guest.
            </p>
          </div>
          <div class="card">
            <h3>Community service</h3>
            <p>
              Blood donation, tree plantation and cleanliness drives in the
              spirit of service.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
